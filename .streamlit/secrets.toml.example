# ==========================================
# 🤖 LLM & Vector Database Configuration
# ==========================================
OPENAI_API_KEY = "your_openai_api_key_here"
OPENAI_MODEL_NAME = "gpt-4o"

PINECONE_API_KEY = "your_pinecone_api_key_here"
PINECONE_INDEX_NAME = "pazarlama-verileri"

# ==========================================
# 📊 ClickHouse Configuration
# ==========================================
CLICKHOUSE_HOST = "localhost"
CLICKHOUSE_PORT = "8123"
CLICKHOUSE_USERNAME = "your_clickhouse_username"
CLICKHOUSE_PASSWORD = "your_clickhouse_password"
CLICKHOUSE_DB = "your_clickhouse_database"
CLICKHOUSE_SECURE = "false" # Set "true" if using HTTPS / SSL (e.g. port 443 or ngrok)
CLICKHOUSE_VERIFY = "true"  # Recommended; false is supported with an explicit UI warning
# CLICKHOUSE_CA_CERT = "/path/to/private-ca.pem"
ALLOW_SQLITE_FALLBACK = "false" # Explicit opt-in; UI warns when fallback is active

# ==========================================
# 🐘 PostgreSQL Configuration
# ==========================================
POSTGRES_HOST = "localhost"
POSTGRES_PORT = "5432"
POSTGRES_USER = "your_postgres_username"
POSTGRES_PASSWORD = "your_postgres_password"
POSTGRES_DATABASE = "your_postgres_database"

# ==========================================
# 📁 SQLite Database
# ==========================================
SQLITE_DB_PATH = "insight_generation_bot.db"

# ==========================================
# 📡 Logging & Observability (Graylog / GELF)
# ==========================================
ENVIRONMENT = "development"
LOG_LEVEL = "INFO"
GRAYLOG_ENABLED = "false"
GRAYLOG_HOST = "localhost"
GRAYLOG_PORT = "12201"
GRAYLOG_PROTOCOL = "udp" # Options: "udp", "tcp", "http", or "https"
